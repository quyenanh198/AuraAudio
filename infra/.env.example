DATABASE_URL=postgresql+psycopg2://aura:aura@localhost:5432/aura
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=aura
S3_SECRET_KEY=aurasecret
S3_BUCKET=aura-media
S3_REGION=us-east-1

# NOTE (dev sandbox only): if Docker Hub image pulls are blocked by your
# network egress policy, run Postgres/Redis natively and substitute MinIO
# with `moto[server]` (S3-compatible mock) pointed at S3_ENDPOINT_URL above --
# the application code is unaware of the difference since it only speaks S3.
